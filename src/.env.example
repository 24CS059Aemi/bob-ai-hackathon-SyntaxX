# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# ── IBM watsonx.ai (OPTIONAL — app works without these) ─────────────────────
# Get from: cloud.ibm.com → watsonx.ai → Project settings
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ── Database ─────────────────────────────────────────────────────────────────
# Leave unset to use SQLite (zero setup, recommended for local demo)
# DATABASE_URL=postgresql://user:password@localhost:5432/grid_advisor

# ── Application ──────────────────────────────────────────────────────────────
APP_PORT=8000
APP_ENV=development

# ── Frontend ─────────────────────────────────────────────────────────────────
# Backend API URL seen by the React app (default: http://localhost:8000)
VITE_API_URL=http://localhost:8000

# ── Notifications (optional) ─────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# ── Data generation ───────────────────────────────────────────────────────────
# Fixed seed ensures reproducible synthetic data (do not change for demo)
RANDOM_SEED=42
